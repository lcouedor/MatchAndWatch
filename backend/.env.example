HOST=0.0.0.0
PORT=3333
NODE_ENV=development
APP_NAME=Match&Watch
APP_KEY=/* Generate with: node ace generate:key */
DRIVE_DISK=local
CACHE_VIEWS=false

# --- Base de données ---
# Pour le développement local, utiliser sqlite
# Pour la production (Supabase/Neon/etc), utiliser pg
DB_CONNECTION=sqlite

# SQLite (local uniquement)
DB_FILE=database/database.sqlite

# PostgreSQL (Supabase / production)
PG_HOST=/* Your PostgreSQL Host */
PG_PORT=5432
PG_USER=/* Your PostgreSQL User */
PG_PASSWORD=/* Your PostgreSQL Password */
PG_DB_NAME=postgres

# --- TMDB ---
TMDB_API_KEY=/* Your TMDB API Key (https://www.themoviedb.org/settings/api) */
TMDB_READ_ACCESS_TOKEN=/* Your TMDB Read Access Token */
TMDB_BASE_URL=https://api.themoviedb.org/3
