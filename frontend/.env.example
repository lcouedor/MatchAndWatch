# URL de l'API backend
# En développement local : http://localhost:3333
# En production : https://<votre-backend>.onrender.com
VUE_APP_API_URL=http://localhost:3333

# URL publique pour les QR codes (optionnel)
# Si absent, utilise l'origine du navigateur (window.location.origin)
# En dev avec d'autres appareils sur le réseau : http://192.168.x.x:8080
# VUE_APP_PUBLIC_URL=http://192.168.x.x:8080
